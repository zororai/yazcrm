        },
        {
            "name": "Data API",
            "description": "Read-only analyst access (Power BI, Excel, R). Basic auth with CRM email/password, or Bearer token."
        },
        {
            "name": "Data Collection v1",
            "description": "Offline data collection from the beneficiary app (Bearer token from /api/auth/login)"
        },
        {
            "name": "Auth"
        }
    ]
}