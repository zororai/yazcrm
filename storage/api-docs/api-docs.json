        "/api/data/forms/{form}/submissions": {
            "get": {
                "tags": [
                    "Data API"
                ],
                "summary": "Submissions as OData-style JSON pages",
                "description": "Returns {\"@odata.context\", \"@odata.count\", \"value\": [rows], \"@odata.nextLink\"}. Rows: _-prefixed metadata, then one key per top-level question; repeats are arrays of objects.",
                "operationId": "ecef197325eb030de12bda0d1568a089",
                "parameters": [
                    {
                        "name": "form",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "$top",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 500,
                            "maximum": 5000
                        }
                    },
                    {
                        "name": "$skip",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 0
                        }
                    },
                    {
                        "name": "from",
                        "in": "query",
                        "description": "Collected on or after (YYYY-MM-DD)",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "description": "Collected on or before (YYYY-MM-DD)",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "pending",
                                "approved",
                                "not_approved",
                                "on_hold"
                            ]
                        }
                    },
                    {
                        "name": "values",
                        "in": "query",
                        "description": "Choice answers as \"label\" (default) or raw \"value\"",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "label",
                                "value"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OData-style page",
                        "content": {
                            "application/json": {
                                "schema": {},
                                "example": {
                                    "@odata.context": "https://crm.example/api/data/forms/12/submissions",
                                    "@odata.count": 1250,
                                    "value": [
                                        {
                                            "_id": 481,
                                            "_status": "approved",
                                            "_collected_at": "2026-10-30T09:15:00+02:00",
                                            "respondent_name": "•••",
                                            "ward": "Ward 2"
                                        }
                                    ],
                                    "@odata.nextLink": "https://crm.example/api/data/forms/12/submissions?%24top=500&%24skip=500"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    },
                    {
                        "basic": []
                    }
                ]
            }
        },
